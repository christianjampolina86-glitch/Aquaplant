# Server & App Configuration
PORT=3000
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT Authentication
JWT_SECRET="aquaplant_jwt_secret_key_capstone_2026"

# ESP32 Device Authentication (Matched in firmware X-Device-Key)
DEVICE_KEY="aquaplant_esp32_device_key_secret_2026"

# Registration Toggle: set to false to close registration after creating initial admin
ALLOW_REGISTRATION=true

# Database Options (Cloud Database / AWS RDS / Cloud SQL / PlanetScale / Railway / MySQL)
# OPTION A: Full Cloud Database Connection String (Recommended for Cloud DBs)
# Example: mysql://username:password@cloud-db-host.com:3306/aquaplant
DATABASE_URL=

# OPTION B: Discrete Connection Parameters
# Leave blank or set to none to use zero-config built-in storage engine
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aquaplant
DB_SSL=true

# SMS Alert Gateway Configuration (Optional live carrier dispatch; defaults to Carrier Simulator)
# Twilio Integration:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Or Generic HTTP SMS Webhook:
SMS_WEBHOOK_URL=
