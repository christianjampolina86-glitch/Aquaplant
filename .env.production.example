# ============================================================================
# AQUAPLANT Production Environment Configuration
# Copy this file to .env in your production environment
# ============================================================================

NODE_ENV=production
PORT=3000

# Authentication & Security
JWT_SECRET="generate-a-secure-random-64-character-string-here"
DEVICE_KEY="aquaplant_esp32_device_key_secret_2026"
ALLOW_REGISTRATION=true

# ============================================================================
# Database Configuration (MySQL / MariaDB / Cloud Database)
# ============================================================================
# OPTION A: Full connection URI (Recommended for Cloud / PaaS)
# Example: mysql://sql12839434:6jAkCCie5a@sql12.freesqldatabase.com:3306/sql12839434
DATABASE_URL=""

# OPTION B: Discrete connection variables (If not using DATABASE_URL)
DB_HOST="sql12.freesqldatabase.com"
DB_PORT=3306
DB_USER="sql12839434"
DB_PASSWORD="your-database-password"
DB_NAME="sql12839434"
DB_SSL=false

# ============================================================================
# SMS Alert Gateway Configuration
# ============================================================================
# Option 1: Semaphore (Recommended for Philippines · ₱500 Budget · ₱0.50/SMS)
# Sign up and get your API key at https://semaphore.co (top-up via GCash)
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="SEMAPHORE"

# Option 2: Twilio (Global International Gateway)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Option 3: Webhook Gateway
SMS_WEBHOOK_URL=""
