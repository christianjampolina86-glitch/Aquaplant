{
  "entities": {
    "sensorReading": {
      "title": "Sensor Reading",
      "description": "Hydroponic telemetry data including pH, TDS, water level, and temperature",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tds": { "type": "number", "description": "TDS level in ppm" },
        "ph": { "type": "number", "description": "Water pH value" },
        "water_level": { "type": "string", "description": "Water level status (LOW, NORMAL, FULL, HIGH)" },
        "water_temp": { "type": "number", "description": "Water temperature in Celsius" },
        "ambient_temp": { "type": "number", "description": "Ambient air temperature in Celsius" },
        "humidity": { "type": "number", "description": "Relative humidity percentage" },
        "ec": { "type": "number", "description": "Electrical conductivity in mS/cm" },
        "timestamp": { "type": "string", "description": "ISO timestamp string" }
      },
      "required": ["tds", "ph", "water_level", "timestamp"]
    },
    "controlState": {
      "title": "Control State",
      "description": "Automated and manual hardware actuator relay states",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "auto_mode": { "type": "boolean" },
        "drain_valve": { "type": "boolean" },
        "fill_valve": { "type": "boolean" },
        "nutrient_pump_a": { "type": "boolean" },
        "nutrient_pump_b": { "type": "boolean" },
        "ph_up_pump": { "type": "boolean" },
        "ph_down_pump": { "type": "boolean" },
        "circulation_pump": { "type": "boolean" },
        "target_tds_min": { "type": "number" },
        "target_tds_max": { "type": "number" },
        "target_ph_min": { "type": "number" },
        "target_ph_max": { "type": "number" },
        "flush_in_progress": { "type": "boolean" },
        "last_flushed_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["auto_mode", "drain_valve", "fill_valve"]
    },
    "smsSetting": {
      "title": "SMS Setting",
      "description": "SMS and cellular GSM notification parameters and thresholds",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipient_phone": { "type": "string", "maxLength": 30 },
        "carrier": { "type": "string", "maxLength": 50 },
        "alerts_enabled": { "type": "boolean" },
        "notify_flush": { "type": "boolean" },
        "notify_low_ph": { "type": "boolean" },
        "notify_high_ph": { "type": "boolean" },
        "notify_low_tds": { "type": "boolean" },
        "notify_high_tds": { "type": "boolean" },
        "notify_low_water": { "type": "boolean" },
        "sim_signal_strength": { "type": "number" },
        "sim_status": { "type": "string", "maxLength": 50 },
        "updated_at": { "type": "string" }
      },
      "required": ["recipient_phone", "alerts_enabled"]
    },
    "smsLog": {
      "title": "SMS Log",
      "description": "Dispatched cellular SMS alert logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipient": { "type": "string", "maxLength": 30 },
        "message": { "type": "string", "maxLength": 300 },
        "event_type": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "maxLength": 20 },
        "timestamp": { "type": "string" },
        "carrier": { "type": "string", "maxLength": 50 }
      },
      "required": ["recipient", "message", "status", "timestamp"]
    },
    "systemLog": {
      "title": "System Log",
      "description": "Audit and diagnostic logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "level": { "type": "string", "maxLength": 20 },
        "message": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 50 },
        "timestamp": { "type": "string" }
      },
      "required": ["level", "message", "category", "timestamp"]
    },
    "userProfile": {
      "title": "User Profile",
      "description": "User profile with role and access details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 100 },
        "display_name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 30 },
        "created_at": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/sensor_readings/{readingId}": {
      "schema": "sensorReading",
      "description": "Telemetry and sensor readings stream from hardware"
    },
    "/control_states/{deviceId}": {
      "schema": "controlState",
      "description": "Actuator control states and automation thresholds"
    },
    "/sms_settings/{settingId}": {
      "schema": "smsSetting",
      "description": "GSM/SMS notification setup and alert flags"
    },
    "/sms_logs/{logId}": {
      "schema": "smsLog",
      "description": "Audit record of sent SMS messages"
    },
    "/system_logs/{logId}": {
      "schema": "systemLog",
      "description": "System event audit trail and diagnosis logs"
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User account information and roles"
    }
  }
}
