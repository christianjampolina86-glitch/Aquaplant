rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Connection validation test endpoint
    match /test/{docId} {
      allow read: if isValidId(docId);
      allow write: if false;
    }

    // Sensor Readings (telemetry data)
    function isValidSensorReading(data) {
      return data.keys().hasAll(['tds', 'ph', 'water_level', 'timestamp']) &&
             data.tds is number && data.tds >= 0 && data.tds <= 5000 &&
             data.ph is number && data.ph >= 0 && data.ph <= 14 &&
             data.water_level is string && data.water_level.size() <= 20 &&
             data.timestamp is string && data.timestamp.size() <= 40;
    }

    match /sensor_readings/{readingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(readingId) && isValidSensorReading(incoming());
      allow update: if isSignedIn() && isValidId(readingId) && isValidSensorReading(incoming());
      allow delete: if isAdmin() && isValidId(readingId);
    }

    // Control States (actuators, pumps, setpoints)
    function isValidControlState(data) {
      return data.keys().hasAll(['auto_mode', 'drain_valve', 'fill_valve']) &&
             data.auto_mode is bool &&
             data.drain_valve is bool &&
             data.fill_valve is bool;
    }

    match /control_states/{deviceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(deviceId) && isValidControlState(incoming());
      allow update: if isSignedIn() && isValidId(deviceId) && isValidControlState(incoming());
      allow delete: if isAdmin() && isValidId(deviceId);
    }

    // SMS Settings
    function isValidSmsSetting(data) {
      return data.keys().hasAll(['recipient_phone', 'alerts_enabled']) &&
             data.recipient_phone is string && data.recipient_phone.size() <= 30 &&
             data.alerts_enabled is bool;
    }

    match /sms_settings/{settingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(settingId) && isValidSmsSetting(incoming());
      allow update: if isSignedIn() && isValidId(settingId) && isValidSmsSetting(incoming());
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // SMS Logs
    function isValidSmsLog(data) {
      return data.keys().hasAll(['recipient', 'message', 'status', 'timestamp']) &&
             data.recipient is string && data.recipient.size() <= 30 &&
             data.message is string && data.message.size() <= 300 &&
             data.status is string && data.status.size() <= 20 &&
             data.timestamp is string && data.timestamp.size() <= 40;
    }

    match /sms_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidSmsLog(incoming());
      allow update: if false; // SMS logs are append-only audit entries
      allow delete: if isAdmin() && isValidId(logId);
    }

    // System Logs
    function isValidSystemLog(data) {
      return data.keys().hasAll(['level', 'message', 'category', 'timestamp']) &&
             data.level is string && data.level.size() <= 20 &&
             data.message is string && data.message.size() <= 500 &&
             data.category is string && data.category.size() <= 50 &&
             data.timestamp is string && data.timestamp.size() <= 40;
    }

    match /system_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidSystemLog(incoming());
      allow update: if false; // System logs are append-only
      allow delete: if isAdmin() && isValidId(logId);
    }

    // User Profiles
    function isValidUserProfile(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role is string && (data.role == 'admin' || data.role == 'operator' || data.role == 'viewer');
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && isValidUserProfile(incoming()) && incoming().role == existing().role) ||
        (isAdmin() && isValidUserProfile(incoming()))
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Admins managed by backend / console
    }
  }
}
